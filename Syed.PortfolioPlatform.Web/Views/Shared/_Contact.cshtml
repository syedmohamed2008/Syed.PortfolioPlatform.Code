@using Syed.PortfolioPlatform.Web.Configurations
@inject PortfolioSettings Settings
<section id="contact" class="py-5">
    <form action="/Portfolio/SendMessage" method="post">
        @Html.AntiForgeryToken()
        <div class="container">

            <h3 class="section-title mb-4">
                Contact Me
            </h3>

            <div class="row align-items-start g-5">

                <!-- LEFT → Message Form -->
                <div class="col-md-6">
                    <div class="contact-card">

                        <form method="post"
                              asp-controller="Portfolio"
                              asp-action="SendMessage">

                            <div class="mb-3">
                                <input type="text"
                                       name="name"
                                       class="form-control"
                                       placeholder="Your Name"
                                       required />
                            </div>

                            <div class="mb-3">
                                <input type="email"
                                       name="email"
                                       class="form-control"
                                       placeholder="Your Email"
                                       required />
                            </div>

                            <div class="mb-3">
                                <textarea name="message"
                                          rows="5"
                                          class="form-control"
                                          placeholder="Your Message"
                                          required></textarea>
                            </div>

                            <button type="submit" class="contact-btn">
                                Send Message
                            </button>

                        </form>

                    </div>
                </div>

                <!-- RIGHT → Email + Social -->
                <div class="col-md-6">
                    <div class="contact-card contact-info">

                        <h5 class="mb-3">Get In Touch</h5>

                        <!-- Email -->
                        <div class="contact-item">
                            <i class="bi bi-envelope-fill"></i>
                            <span>mailtosyedmdsalam@gmail.com</span>
                        </div>

                        <!-- Social -->
                        <div class="mt-4">
                            <h6 class="mb-3">Connect With Me</h6>

                            <div class="social-links">

                                <a href="https://www.linkedin.com/in/syed-md" target="_blank" class="social-box">
                                    <i class="bi bi-linkedin"></i>
                                    <span>LinkedIn</span>
                                </a>

                                <a href="@Settings.GitHubUrl" target="_blank" class="social-box">
                                    <i class="bi bi-github"></i>
                                    <span>GitHub</span>
                                </a>

                                <a href="#" target="_blank" class="social-box" title="Coming Soon">
                                    <i class="bi bi-youtube"></i>
                                    <span>YouTube</span>
                                </a>

                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>
    </form>
</section>