@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var role = Context.Session?.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>@ViewData["Title"] - Admin Panel</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
  

  

    <!-- Custom Admin Styles -->
    <style>
        body {
            background-color: #f4f6f9;
            font-size: 14px;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #212529;
        }

            .sidebar .nav-link {
                color: #adb5bd;
                padding: 10px 15px;
                border-radius: 8px;
                font-weight: 500;
            }

                .sidebar .nav-link:hover {
                    background-color: rgba(255,255,255,0.08);
                    color: #fff;
                }

                .sidebar .nav-link.active {
                    background-color: #0d6efd;
                    color: #fff !important;
                    font-weight: 600;
                }

        /* .content-wrapper {
            margin-left: 250px;
            padding: 0;
        }
 */
        @@media (min-width: 992px) {
            .content-wrapper {
                margin-left: 250px;
            }
        }
    </style>
</head>
<body>

    <!-- Sidebar (Desktop) -->
    <div class="d-none d-lg-block position-fixed sidebar p-3 text-white">

        <div class="mb-4">
            <h5 class="fw-bold mb-1">Admin Panel</h5>
            <small class="text-secondary">Content Management</small>
        </div>

        <ul class="nav nav-pills flex-column gap-2">

            <li class="nav-item">
                <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(controller == "Categories" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index">
                    <i class="bi bi-folder me-2"></i> Categories
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(controller == "Tags" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Tags"
                   asp-action="Index">
                    <i class="bi bi-tags me-2"></i> Tags
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(controller == "Articles" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Articles"
                   asp-action="Index">
                    <i class="bi bi-file-earmark-text me-2"></i> Articles
                </a>
            </li>

            <hr class="border-secondary" />

            <a class="nav-link text-danger"
               asp-area="Admin"
               asp-controller="Account"
               asp-action="login">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>

        </ul>
    </div>

    <!-- Content Wrapper -->
    <div class="content-wrapper">

        <!-- Top Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-4">

            <!-- Mobile Toggle -->
            <button class="btn btn-outline-secondary d-lg-none me-2"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileSidebar">
                <i class="bi bi-list"></i>
            </button>

            <span class="navbar-brand mb-0 h6 fw-semibold">
                @controller
            </span>

            <div class="ms-auto">
                @if (!string.IsNullOrEmpty(role))
                {
                    <span class="text-muted">Welcome, @role</span>
                }
            </div>
        </nav>

        <!-- Page Content -->
        <div class="container-fluid p-4">
            @RenderBody()
        </div>
    </div>

    <!-- Mobile Sidebar -->
    <div class="offcanvas offcanvas-start bg-dark text-white"
         tabindex="-1"
         id="mobileSidebar">

        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Admin Panel</h5>
            <button type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas"></button>
        </div>

        <div class="offcanvas-body">

            <ul class="nav nav-pills flex-column gap-2">

                <li class="nav-item">
                    <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(controller == "Categories" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Categories"
                       asp-action="Index">
                        <i class="bi bi-folder me-2"></i> Categories
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(controller == "Tags" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Tags"
                       asp-action="Index">
                        <i class="bi bi-tags me-2"></i> Tags
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(controller == "Articles" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Articles"
                       asp-action="Index">
                        <i class="bi bi-file-earmark-text me-2"></i> Articles
                    </a>
                </li>

                <hr class="border-secondary" />

                <li class="nav-item">
                    <a class="nav-link text-danger"
                       asp-area="Admin"
                       asp-controller="Account"
                       asp-action="login">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </a>
                </li>

            </ul>

        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>