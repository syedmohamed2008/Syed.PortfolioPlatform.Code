@using Syed.PortfolioPlatform.Application.DTOs.Articles
@model List<ArticleDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@{
    ViewData["Title"] = "Manage Articles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Articles</h4>

    <a asp-area="Admin"
       asp-controller="Articles"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Create Article
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No articles found. Click <strong>Create Article</strong> to add one.
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th style="width: 35%;">Title</th>
                            <th style="width: 35%;">Categories</th>
                            <th style="width: 15%;" class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-truncate"
                                    style="max-width: 250px;"
                                    title="@item.Title">
                                    @item.Title
                                </td>

                                <td>
                                    <span class="badge bg-secondary me-1">
                                        @item.CategoryName
                                    </span>
                                </td>

                                <td class="text-end">

                                    <a asp-area="Admin"
                                       asp-controller="Articles"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary me-2">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="Articles"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Are you sure you want to delete this article?');">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}