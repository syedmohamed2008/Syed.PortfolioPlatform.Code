@model UpdateArticleRequest
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Article";
}

<div class="container py-4">

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0">
            <h4 class="mb-0 fw-semibold">Edit Article</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="Id" />

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control form-control-lg" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <!-- Content -->
                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-semibold"></label>
                    <textarea asp-for="Content" class="form-control rich-editor"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <!-- Category & Tags -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryId"
                                asp-items="Model.CategoryOptions"
                                class="form-select">
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TagIds" class="form-label fw-semibold">Tags</label>
                        <select asp-for="TagIds"
                                asp-items="Model.TagOptions"
                                class="form-select"
                                multiple>
                        </select>
                    </div>
                </div>

                <!-- Existing Image -->
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Image</label>
                        <div>
                            <img src="@Model.ImageUrl"
                                 class="rounded shadow-sm"
                                 style="max-height:150px;" />
                        </div>
                    </div>
                }

                <!-- Upload New Image -->
                <div class="mb-4">
                    <label asp-for="FeaturedImage" class="form-label fw-semibold">Replace Image</label>
                    <input asp-for="FeaturedImage" type="file" class="form-control" />
                </div>

                  <div class="form-check mb-3">
                    <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPublished" class="form-check-label">
                        Publish this article
                    </label>
                </div>


                <label>YouTube Link:</label>
                <input type="url" asp-for="YouTubeLink" class="form-control" />

                <label>PDF Link:</label>
                <input type="text" asp-for="PDFLink" class="form-control" />

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Update Article</button>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/d252ke4k4kre1yyr0a1zvvocfkzmk1putf357z83b8073q0k/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

    <script>
        tinymce.init({
        selector: '#Content',
        height: 500,

        plugins: 'codesample autolink link image', // ✅ added image

        toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | codesample | link image', // ✅ added image button

        codesample_languages: [
        { text: 'HTML/XML', value: 'markup' },
        { text: 'JavaScript', value: 'javascript' },
        { text: 'C#', value: 'csharp' },
        { text: 'CSS', value: 'css' },
        { text: 'SQL', value: 'sql' }
        ],

        autolink: true,
        codesample_global_prismjs: true
        });
    </script>
}